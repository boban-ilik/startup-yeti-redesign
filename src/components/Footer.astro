---
// src/components/Footer.astro — shared footer: newsletter, categories, links, Google Preferred Sources.
import NewsletterForm from "./NewsletterForm.astro";
const year = new Date().getFullYear();
const categories = [
  ["/startup", "Startup"], ["/business", "Business"], ["/marketing", "Marketing"], ["/remote-work", "Remote Work"],
  ["/productivity", "Productivity"], ["/team-management", "Team Management"], ["/innovation", "Innovation"], ["/founder-wellbeing", "Founder Wellbeing"],
];
const links = [["/blog", "All Articles"], ["/resources", "Resources"], ["/calculator", "SaaS Calculator"], ["/about", "About"], ["/privacy-policy", "Privacy Policy"]];
---
<footer class="border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900">
  <div class="wrap grid gap-12 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <img src="/logo.webp" alt="Startup Yeti" width="400" height="128" class="h-10 w-auto dark:hidden" />
      <img src="/logo-dark.webp" alt="Startup Yeti" width="400" height="128" class="hidden h-10 w-auto dark:block" />
      <p class="mt-5 max-w-sm text-slate-600 dark:text-slate-300">
        Build, run, and grow your startup with confidence. Proven frameworks and tactical advice from founders who've been there.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href="https://www.linkedin.com/company/startup-yeti/" target="_blank" rel="noopener noreferrer" class="btn-secondary">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
        <!-- Google Preferred Sources opt-in (publisher.js, wired below); "manual" means the dialog opens only on click. -->
        <button type="button" class="pref-source-btn btn-secondary">
          <svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
          Make us preferred on Google
        </button>
      </div>
    </div>

    <div class="md:col-span-3">
      <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Categories</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm sm:grid-cols-1">
        {categories.map(([href, label]) => (
          <li><a href={href} class="text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">{label}</a></li>
        ))}
      </ul>
    </div>

    <div class="md:col-span-4">
      <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Newsletter</h2>
      <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">Weekly tactics for early-stage founders. No spam, unsubscribe anytime.</p>
      <div class="mt-4"><NewsletterForm compact /></div>
      <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {links.map(([href, label]) => (
          <li><a href={href} class="text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">{label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-200 dark:border-slate-800">
    <p class="wrap py-6 text-sm text-slate-500 dark:text-slate-400">&copy; {year} Startup Yeti. All rights reserved.</p>
  </div>
</footer>

<script is:inline async preferred-sources-control="manual" src="https://news.google.com/swg/js/v1/publisher.js"></script>
<script is:inline>
  (self.PREFERRED_SOURCE = self.PREFERRED_SOURCE || []).push(function (ps) {
    ps.init({ theme: 'light', lang: 'en' });
    document.querySelectorAll('.pref-source-btn').forEach(function (btn) {
      btn.addEventListener('click', function () { ps.addPreferredSource(); });
    });
  });
</script>
