---
// src/components/Footer.astro
// Shared footer component with category links for better internal linking (SEO)
---

<footer class="bg-slate-900 text-white py-16">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-4 gap-12 mb-12">
      <!-- Logo & About -->
      <div class="md:col-span-1">
        <div class="h-16 mb-4">
          <img src="/footer logo.png" class="h-full w-auto" alt="Startup Yeti" />
        </div>
        <p class="text-slate-400 text-sm">Helping founders build and scale successful startups with actionable insights.</p>

        <!-- Google Preferred Sources opt-in (news.google.com publisher.js, wired below) -->
        <button
          type="button"
          class="pref-source-btn mt-5 inline-flex items-center gap-2.5 rounded-xl border border-slate-700 px-4 py-2.5 text-sm font-medium text-slate-300 transition-colors hover:border-yeti-400 hover:text-white"
        >
          <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
          Make us preferred on Google
        </button>
      </div>

      <!-- Categories -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4">Categories</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/startup" class="text-slate-400 hover:text-yeti-400 transition-colors">Startup</a></li>
          <li><a href="/business" class="text-slate-400 hover:text-yeti-400 transition-colors">Business</a></li>
          <li><a href="/productivity" class="text-slate-400 hover:text-yeti-400 transition-colors">Productivity</a></li>
          <li><a href="/team-management" class="text-slate-400 hover:text-yeti-400 transition-colors">Team Management</a></li>
          <li><a href="/remote-work" class="text-slate-400 hover:text-yeti-400 transition-colors">Remote Work</a></li>
        </ul>
      </div>

      <!-- More Topics -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4">More Topics</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/marketing" class="text-slate-400 hover:text-yeti-400 transition-colors">Marketing</a></li>
          <li><a href="/founder-wellbeing" class="text-slate-400 hover:text-yeti-400 transition-colors">Founder Wellbeing</a></li>
          <li><a href="/innovation" class="text-slate-400 hover:text-yeti-400 transition-colors">Innovation</a></li>
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4">Quick Links</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="text-slate-400 hover:text-yeti-400 transition-colors">Home</a></li>
          <li><a href="/blog" class="text-slate-400 hover:text-yeti-400 transition-colors">All Articles</a></li>
          <li><a href="/resources" class="text-slate-400 hover:text-yeti-400 transition-colors">Resources</a></li>
          <li><a href="/about" class="text-slate-400 hover:text-yeti-400 transition-colors">About</a></li>
          <li><a href="/privacy-policy" class="text-slate-400 hover:text-yeti-400 transition-colors">Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-800 pt-8">
      <p class="text-slate-500 text-sm text-center">&copy; {new Date().getFullYear()} Startup Yeti. All rights reserved.</p>
    </div>
  </div>
</footer>

<!-- Google Preferred Sources: official publisher API. "manual" control means the
     dialog opens only from our .pref-source-btn click, never automatically.
     news.google.com must stay allowlisted in the CSP (public/_headers). -->
<script is:inline async preferred-sources-control="manual" src="https://news.google.com/swg/js/v1/publisher.js"></script>
<script is:inline>
  (self.PREFERRED_SOURCE = self.PREFERRED_SOURCE || []).push(function (ps) {
    ps.init({ theme: 'light', lang: 'en' });
    document.querySelectorAll('.pref-source-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        ps.addPreferredSource();
      });
    });
  });
</script>
