---
// Section-level newsletter call to action, reused on category, blog, article and tool pages.
import NewsletterForm from "./NewsletterForm.astro";
interface Props { heading: string; body: string; note?: string }
const { heading, body, note = "No spam. Unsubscribe anytime." } = Astro.props;
---
<section class="wrap py-16 md:py-24">
  <div class="rounded-3xl border border-yeti-100 bg-yeti-50 px-6 py-12 text-center md:px-12 md:py-16 dark:border-yeti-900/60 dark:bg-yeti-950/40">
    <h2 class="display text-3xl md:text-4xl">{heading}</h2>
    <p class="lead mx-auto mt-4 max-w-xl">{body}</p>
    <div class="mx-auto mt-8 max-w-md"><NewsletterForm /></div>
    <p class="mt-4 text-sm text-slate-600 dark:text-slate-400">{note}</p>
  </div>
</section>
