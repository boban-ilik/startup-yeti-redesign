---
// src/components/Nav.astro — site header: primary links, more-menu, search, theme toggle, CTA.
const primary = [
  { href: "/startup", label: "Startup" },
  { href: "/business", label: "Business" },
  { href: "/marketing", label: "Marketing" },
  { href: "/remote-work", label: "Remote Work" },
  { href: "/productivity", label: "Productivity" },
];
const more = [
  { href: "/team-management", label: "Team Management" },
  { href: "/founder-wellbeing", label: "Founder Wellbeing" },
  { href: "/innovation", label: "Innovation" },
  { href: "/resources", label: "Resources" },
  { href: "/calculator", label: "SaaS Calculator" },
  { href: "/about", label: "About" },
];
const current = Astro.url.pathname.replace(/\/$/, "");
const isActive = (href: string) => current === href || (href !== "/" && current.startsWith(href + "/"));
const linkClass = (href: string) =>
  `rounded-md px-2.5 py-2 text-sm font-medium transition-colors duration-150 hover:text-slate-900 dark:hover:text-white ${
    isActive(href) ? "text-slate-900 dark:text-white" : "text-slate-600 dark:text-slate-300"
  }`;
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-slate-200 bg-white/95 dark:border-slate-800 dark:bg-slate-950/95">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center" aria-label="Startup Yeti home">
      <img src="/logo.webp" alt="Startup Yeti" width="400" height="128" class="h-9 w-auto dark:hidden" />
      <img src="/logo-dark.webp" alt="Startup Yeti" width="400" height="128" class="hidden h-9 w-auto dark:block" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {primary.map((l) => (
        <a href={l.href} class={linkClass(l.href)} aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a>
      ))}
      <div class="relative" data-more>
        <button type="button" class="inline-flex items-center gap-1 rounded-md px-2.5 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white" aria-expanded="false" aria-haspopup="true" aria-controls="more-menu">
          More
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
        </button>
        <div id="more-menu" class="absolute left-0 top-full mt-2 hidden w-56 rounded-lg border border-slate-200 bg-white p-1.5 shadow-lg shadow-slate-900/5 dark:border-slate-700 dark:bg-slate-900" role="menu">
          {more.map((l) => (
            <a href={l.href} role="menuitem" class="block rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-white">{l.label}</a>
          ))}
        </div>
      </div>
    </nav>

    <div class="flex items-center gap-1">
      <div class="relative" data-search>
        <button type="button" id="search-toggle" class="rounded-md p-2.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white" aria-label="Search articles" aria-expanded="false" aria-controls="search-panel">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0z"/></svg>
        </button>
        <div id="search-panel" class="fixed inset-x-4 top-20 hidden rounded-xl border border-slate-200 bg-white p-3 shadow-xl shadow-slate-900/10 sm:absolute sm:inset-x-auto sm:right-0 sm:top-full sm:mt-2 sm:w-96 dark:border-slate-700 dark:bg-slate-900">
          <label for="search-input" class="sr-only">Search articles</label>
          <input id="search-input" type="search" autocomplete="off" placeholder="Search articles" class="input py-2.5" />
          <div id="search-status" class="meta mt-2 px-1" aria-live="polite"></div>
          <ul id="search-results" class="mt-1 max-h-80 divide-y divide-slate-100 overflow-y-auto dark:divide-slate-800" role="listbox"></ul>
        </div>
      </div>

      <button type="button" id="theme-toggle" class="rounded-md p-2.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white" aria-label="Switch to dark theme">
        <svg class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        <svg class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      </button>

      <a href="/blog" data-sy-cta="nav-get-the-guides" class="btn-primary ml-1 hidden sm:inline-flex">Get the Guides</a>

      <button type="button" id="menu-toggle" class="rounded-md p-2.5 text-slate-700 hover:bg-slate-100 lg:hidden dark:text-slate-200 dark:hover:bg-slate-800" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white lg:hidden dark:border-slate-800 dark:bg-slate-950">
    <nav class="wrap grid gap-1 py-3" aria-label="Mobile">
      {[...primary, ...more].map((l) => (
        <a href={l.href} class={`rounded-md px-3 py-3 text-base font-medium ${isActive(l.href) ? "bg-slate-100 text-slate-900 dark:bg-slate-800 dark:text-white" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"}`} aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a>
      ))}
      <a href="/blog" class="btn-primary btn-lg mt-2 sm:hidden">Get the Guides</a>
    </nav>
  </div>
</header>

<script>
  (() => {
    const header = document.getElementById('site-header')!;

    // Theme
    const themeBtn = document.getElementById('theme-toggle');
    const setThemeLabel = () => {
      const dark = document.documentElement.classList.contains('dark');
      themeBtn?.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    };
    setThemeLabel();
    themeBtn?.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); localStorage.removeItem('darkMode'); } catch {}
      setThemeLabel();
    });

    // Mobile menu
    const menuBtn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    menuBtn?.addEventListener('click', () => {
      const open = menu!.classList.toggle('hidden') === false;
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });

    // "More" menu (click + hover intent, closes on outside click / Escape)
    const more = header.querySelector('[data-more]');
    const moreBtn = more?.querySelector('button');
    const moreMenu = document.getElementById('more-menu');
    const setMore = (open: boolean) => {
      moreMenu?.classList.toggle('hidden', !open);
      moreBtn?.setAttribute('aria-expanded', String(open));
    };
    moreBtn?.addEventListener('click', () => setMore(moreMenu!.classList.contains('hidden')));
    more?.addEventListener('mouseenter', () => setMore(true));
    more?.addEventListener('mouseleave', () => setMore(false));

    // Search: static index built at deploy time.
    const searchBtn = document.getElementById('search-toggle');
    const panel = document.getElementById('search-panel');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const status = document.getElementById('search-status');
    const list = document.getElementById('search-results');
    let index: { s: string; t: string; e: string; c: string; n: string }[] | null = null;
    const esc = (s: string) => s.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch] as string));
    const setSearch = (open: boolean) => {
      panel?.classList.toggle('hidden', !open);
      searchBtn?.setAttribute('aria-expanded', String(open));
      if (open) { input?.focus(); if (!index) load(); } else if (input) { input.value = ''; render([]); }
    };
    const load = async () => {
      if (status) status.textContent = 'Loading…';
      try { index = await (await fetch('/search-index.json')).json(); if (status) status.textContent = 'Type to search ' + index!.length + ' articles'; }
      catch { if (status) status.textContent = 'Search is unavailable right now.'; }
    };
    const render = (hits: typeof index) => {
      if (!list) return;
      list.innerHTML = (hits || []).map((h) =>
        `<li role="option"><a href="/${esc(h.c)}/${esc(h.s)}" class="block rounded-md px-2 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800">
          <span class="block text-sm font-semibold text-slate-900 dark:text-white">${esc(h.t)}</span>
          <span class="mt-0.5 block text-xs text-slate-500 dark:text-slate-400">${esc(h.n)} · ${esc(h.e)}</span></a></li>`).join('');
    };
    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!index || q.length < 2) { render([]); if (status && index) status.textContent = 'Type to search ' + index.length + ' articles'; return; }
      const hits = index.filter((p) => (p.t + ' ' + p.e + ' ' + p.n).toLowerCase().includes(q)).slice(0, 8);
      render(hits);
      if (status) status.textContent = hits.length ? hits.length + ' result' + (hits.length === 1 ? '' : 's') : 'No articles match “' + input.value.trim() + '”';
    });
    searchBtn?.addEventListener('click', () => setSearch(panel!.classList.contains('hidden')));
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (panel && !panel.classList.contains('hidden') && !panel.contains(t) && !searchBtn!.contains(t)) setSearch(false);
      if (moreMenu && !moreMenu.classList.contains('hidden') && !more!.contains(t)) setMore(false);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setSearch(false); setMore(false); } });
  })();
</script>
