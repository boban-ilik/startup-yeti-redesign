---
// src/components/CategoryPage.astro — shared template for the eight category landing pages.
import Base from "../layouts/Base.astro";
import PostCard from "./PostCard.astro";
import NewsletterCta from "./NewsletterCta.astro";
import { fetchPosts } from "../lib/wordpress";

interface Props {
  slug: string;
  name: string;
  title: string;
  description: string;
  h1: string;
  intro: string;
  topics?: { title: string; text: string }[];
  latestHeading: string;
  emptyText: string;
  ctaHeading: string;
  ctaBody: string;
}
const { slug, name, title, description, h1, intro, topics = [], latestHeading, emptyText, ctaHeading, ctaBody } = Astro.props;
const posts = await fetchPosts(name);
const siteUrl = "https://www.startupyeti.com";
---
<Base title={title} description={description} path={`/${slug}`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": `${siteUrl}/${slug}#webpage`,
      "name": name,
      "description": description,
      "url": `${siteUrl}/${slug}`,
      "inLanguage": "en-US",
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": posts.slice(0, 10).map((post, i) => ({
          "@type": "ListItem", "position": i + 1, "url": `${siteUrl}/${slug}/${post.slug}`, "name": post.title
        }))
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": name, "item": `${siteUrl}/${slug}` }
      ]
    })} />
  </Fragment>

  <section class="wrap pb-12 pt-16 md:pb-16 md:pt-24">
    <div class="max-w-3xl">
      <h1 class="display text-4xl leading-[1.08] sm:text-5xl lg:text-6xl">{h1}</h1>
      <p class="lead mt-6 max-w-2xl">{intro}</p>
      <p class="meta mt-5 tabular-nums">{posts.length} {posts.length === 1 ? "article" : "articles"}</p>
    </div>
  </section>

  {topics.length > 0 && (
    <section class="wrap border-t border-slate-200 py-10 dark:border-slate-800" aria-label="Topics covered">
      <ul class="grid gap-8 sm:grid-cols-3">
        {topics.map((t) => (
          <li>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">{t.title}</h2>
            <p class="mt-1.5 text-slate-600 dark:text-slate-300">{t.text}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="wrap border-t border-slate-200 py-12 md:py-16 dark:border-slate-800" aria-labelledby="latest-heading">
    <h2 id="latest-heading" class="display text-3xl md:text-4xl">{latestHeading}</h2>
    {posts.length > 0 ? (
      <ul class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => {
          const img = post.featuredImage?.node;
          return (
            <PostCard as="li" href={`/${slug}/${post.slug}`} title={post.title} excerpt={post.excerpt} date={post.date}
              image={img ? { src: img.sourceUrl, srcset: img.srcset, alt: img.altText, width: img.mediaDetails.width, height: img.mediaDetails.height } : null} />
          );
        })}
      </ul>
    ) : (
      <div class="mt-10 max-w-md">
        <h3 class="text-xl font-semibold text-slate-900 dark:text-white">No articles yet</h3>
        <p class="mt-2 text-slate-600 dark:text-slate-300">{emptyText}</p>
      </div>
    )}
  </section>

  <NewsletterCta heading={ctaHeading} body={ctaBody} />
</Base>
