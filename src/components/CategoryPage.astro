---
// src/components/CategoryPage.astro — shared template for the eight category landing pages.
import Base from "../layouts/Base.astro";
import PostCard from "./PostCard.astro";
import NewsletterCta from "./NewsletterCta.astro";
import { fetchPosts } from "../lib/wordpress";

interface Props {
  slug: string;
  name: string;
  title: string;
  description: string;
  h1: string;
  intro: string;
  topics?: { title: string; text: string }[];
  latestHeading: string;
  emptyText: string;
  ctaHeading: string;
  ctaBody: string;
}
const { slug, name, title, description, h1, intro, topics = [], latestHeading, emptyText, ctaHeading, ctaBody } = Astro.props;
const posts = await fetchPosts(name);
const siteUrl = "https://www.startupyeti.com";
---
<Base title={title} description={description} path={`/${slug}`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": `${siteUrl}/${slug}#webpage`,
      "name": name,
      "description": description,
      "url": `${siteUrl}/${slug}`,
      "inLanguage": "en-US",
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": posts.slice(0, 10).map((post, i) => ({
          "@type": "ListItem", "position": i + 1, "url": `${siteUrl}/${slug}/${post.slug}`, "name": post.title
        }))
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": name, "item": `${siteUrl}/${slug}` }
      ]
    })} />
  </Fragment>

  <section class="hero-tint border-b border-slate-200 dark:border-slate-800">
    <div class="wrap pb-14 pt-16 text-center md:pb-20 md:pt-24">
      <p class="chip tabular-nums">{posts.length} {posts.length === 1 ? "article" : "articles"}</p>
      <h1 class="display mx-auto mt-5 max-w-4xl text-4xl leading-[1.08] sm:text-5xl lg:text-6xl">{h1}</h1>
      <p class="lead mx-auto mt-6 max-w-2xl">{intro}</p>
    </div>
  </section>

  {topics.length > 0 && (
    <section class="wrap py-12 md:py-16" aria-label="Topics covered">
      <ul class="grid gap-5 sm:grid-cols-3">
        {topics.map((t, i) => (
          <li class="card p-6">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-yeti-50 text-sm font-bold tabular-nums text-yeti-800 dark:bg-yeti-950 dark:text-yeti-300" aria-hidden="true">{i + 1}</span>
            <h2 class="mt-4 text-lg font-bold text-slate-900 dark:text-white">{t.title}</h2>
            <p class="mt-2 text-slate-600 dark:text-slate-300">{t.text}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="band border-y border-slate-200 dark:border-slate-800" aria-labelledby="latest-heading">
    <div class="wrap section">
      <h2 id="latest-heading" class="display text-3xl md:text-4xl">{latestHeading}</h2>
      {posts.length > 0 ? (
        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => {
            const img = post.featuredImage?.node;
            return (
              <PostCard as="li" href={`/${slug}/${post.slug}`} title={post.title} excerpt={post.excerpt} date={post.date}
                image={img ? { src: img.sourceUrl, srcset: img.srcset, alt: img.altText, width: img.mediaDetails.width, height: img.mediaDetails.height } : null} />
            );
          })}
        </ul>
      ) : (
        <div class="card mt-10 max-w-md p-6">
          <h3 class="text-xl font-semibold text-slate-900 dark:text-white">No articles yet</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-300">{emptyText}</p>
        </div>
      )}
    </div>
  </section>

  <NewsletterCta heading={ctaHeading} body={ctaBody} />
</Base>
