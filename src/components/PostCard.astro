---
// src/components/PostCard.astro — one article card for home, category, blog and related grids.
import { SIZES } from "../lib/images";
interface Props {
  href: string;
  title: string;
  excerpt?: string;
  date?: string;
  categoryName?: string;
  categoryHref?: string;
  image?: { src: string; srcset?: string; alt: string; width?: number; height?: number } | null;
  compact?: boolean;
  eager?: boolean;
  as?: "article" | "li";
  headingLevel?: "h2" | "h3";
}
const { href, title, excerpt, date, categoryName, categoryHref, image, compact = false, eager = false, as: Tag = "article", headingLevel: Heading = "h3" } = Astro.props;
const dateText = date ? new Date(date).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : null;
---
<Tag class="card card-hover group flex h-full flex-col overflow-hidden" data-category={categoryName}>
  <a href={href} class="block bg-slate-100 dark:bg-slate-800" tabindex="-1" aria-hidden="true">
    {image ? (
      <img
        src={image.src}
        srcset={image.srcset}
        sizes={compact ? SIZES.cardCompact : SIZES.card}
        alt=""
        width={image.width || 1200}
        height={image.height || 630}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        class="aspect-[1200/630] w-full object-cover"
      />
    ) : (
      <div class="aspect-[1200/630] w-full"></div>
    )}
  </a>
  <div class={`flex flex-1 flex-col ${compact ? "p-4" : "p-5 md:p-6"}`}>
    {categoryName && (
      categoryHref
        ? <a href={categoryHref} class="chip self-start">{categoryName}</a>
        : <span class="chip self-start">{categoryName}</span>
    )}
    <Heading class={`${categoryName ? "mt-3" : ""} font-bold leading-snug text-slate-900 dark:text-white ${compact ? "text-base" : "text-lg md:text-xl"}`}>
      <a href={href} class="transition-colors duration-150 group-hover:text-yeti-800 dark:group-hover:text-yeti-300">{title}</a>
    </Heading>
    {!compact && excerpt && <p class="mb-5 mt-2 line-clamp-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300" set:html={excerpt} />}
    {dateText && (
      <p class="meta mt-auto flex items-center justify-between border-t border-slate-100 pt-4 dark:border-slate-800">
        <time datetime={date}>{dateText}</time>
        <span aria-hidden="true" class="font-semibold text-yeti-700 transition-transform duration-150 group-hover:translate-x-0.5 dark:text-yeti-400">→</span>
      </p>
    )}
  </div>
</Tag>
