---
// src/pages/calculator.astro — SaaS Metrics Calculator
import Base from "../layouts/Base.astro";
import NewsletterCta from "../components/NewsletterCta.astro";

const field = "input w-full py-3 text-lg font-semibold tabular-nums";
const metrics = [
  { id: "ltv", title: "Customer Lifetime Value", initial: "$0", note: "Average revenue per customer over their lifetime" },
  { id: "ratio", title: "LTV:CAC Ratio", initial: "0:1", note: "Target: 3:1 or higher", badge: true },
  { id: "growth", title: "Net MRR Growth Rate", initial: "0%", note: "Based on current churn rate" },
  { id: "payback", title: "CAC Payback Period", initial: "0 mo", note: "Time to recover acquisition cost" },
];
---
<Base title="SaaS Metrics Calculator | Startup Yeti" description="Calculate your SaaS metrics including LTV, CAC ratio, growth rate, and burn multiple. Free tool for SaaS founders." path="/calculator">
  <section class="wrap pb-10 pt-16 md:pb-12 md:pt-24">
    <div class="max-w-3xl">
      <h1 class="display text-4xl leading-[1.08] sm:text-5xl lg:text-6xl">SaaS Metrics Calculator</h1>
      <p class="lead mt-6 max-w-2xl">Calculate your key SaaS metrics instantly. Understand your LTV:CAC ratio, growth rate, and burn multiple to make better decisions.</p>
      <ul class="meta mt-5 flex flex-wrap gap-x-5 gap-y-1.5">
        <li>No signup required</li>
        <li>Instant results</li>
        <li>100% free</li>
      </ul>
    </div>
  </section>

  <section class="wrap border-t border-slate-200 py-12 md:py-16 dark:border-slate-800">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <form id="calc-form" class="space-y-6" novalidate>
        <h2 class="display text-2xl">Your Metrics</h2>
        <div>
          <label for="mrr" class="block text-sm font-semibold text-slate-900 dark:text-white">Monthly Recurring Revenue (MRR) <span class="font-normal text-slate-500 dark:text-slate-400">in USD</span></label>
          <div class="relative mt-2">
            <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-slate-500 dark:text-slate-400">$</span>
            <input type="number" id="mrr" inputmode="decimal" placeholder="50000" min="0" step="1000" class={`${field} pl-9`} />
          </div>
        </div>
        <div>
          <label for="customers" class="block text-sm font-semibold text-slate-900 dark:text-white">Total Customers</label>
          <input type="number" id="customers" inputmode="numeric" placeholder="500" min="1" step="1" class={`${field} mt-2`} />
        </div>
        <div>
          <label for="churn" class="block text-sm font-semibold text-slate-900 dark:text-white">Monthly Churn Rate <span class="font-normal text-slate-500 dark:text-slate-400">percentage</span></label>
          <div class="relative mt-2">
            <input type="number" id="churn" inputmode="decimal" placeholder="5" min="0" max="100" step="0.1" class={`${field} pr-10`} />
            <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-slate-500 dark:text-slate-400">%</span>
          </div>
        </div>
        <div>
          <label for="cac" class="block text-sm font-semibold text-slate-900 dark:text-white">Customer Acquisition Cost (CAC) <span class="font-normal text-slate-500 dark:text-slate-400">per customer</span></label>
          <div class="relative mt-2">
            <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-slate-500 dark:text-slate-400">$</span>
            <input type="number" id="cac" inputmode="decimal" placeholder="500" min="0" step="10" class={`${field} pl-9`} />
          </div>
        </div>
        <div>
          <label for="arpa" class="block text-sm font-semibold text-slate-900 dark:text-white">Average Revenue Per Account (ARPA) <span class="font-normal text-slate-500 dark:text-slate-400">auto-calculated</span></label>
          <div class="relative mt-2">
            <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-slate-500 dark:text-slate-400">$</span>
            <input type="number" id="arpa" placeholder="100" min="0" step="1" readonly class={`${field} pl-9 bg-slate-50 dark:bg-slate-800`} />
          </div>
        </div>
        <p id="calc-error" class="hidden text-sm font-medium text-red-700 dark:text-red-400" role="alert"></p>
        <button type="submit" id="calculate-btn" class="btn-primary btn-lg w-full">Calculate Metrics</button>
      </form>

      <div>
        <h2 class="display text-2xl">Results</h2>
        <dl id="results-container" class="mt-6 grid gap-x-8 gap-y-6 border-t border-slate-200 sm:grid-cols-2 dark:border-slate-800">
          {metrics.map((m) => (
            <div class="pt-5">
              <dt class="text-sm font-semibold text-slate-600 dark:text-slate-300">{m.title}</dt>
              <dd class="display mt-1 text-3xl tabular-nums md:text-4xl" id={`${m.id}-value`}>{m.initial}</dd>
              <dd class="meta mt-1.5 flex flex-wrap items-center gap-2">
                {m.badge && <span id="ratio-badge" class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200">–</span>}
                <span id={`${m.id}-description`}>{m.note}</span>
              </dd>
            </div>
          ))}
        </dl>
        <div id="insights-box" class="mt-8 hidden rounded-lg border border-slate-200 p-6 dark:border-slate-800">
          <h3 class="text-base font-semibold text-slate-900 dark:text-white">Key Insights</h3>
          <ul id="insights-list" class="mt-3 list-disc space-y-2 pl-5 text-slate-700 dark:text-slate-300"></ul>
        </div>
      </div>
    </div>
  </section>

  <NewsletterCta heading="Want to Improve These Metrics?" body="Get weekly insights on building and scaling SaaS businesses with proven frameworks." />

  <script>
    (() => {
      const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
      const mrr = $('mrr'), customers = $('customers'), churn = $('churn'), cac = $('cac'), arpa = $('arpa');
      const form = document.getElementById('calc-form') as HTMLFormElement;
      const error = document.getElementById('calc-error')!;
      const insightsBox = document.getElementById('insights-box')!;
      const updateARPA = () => {
        const m = parseFloat(mrr.value) || 0, c = parseFloat(customers.value) || 0;
        arpa.value = c > 0 ? (m / c).toFixed(2) : '';
      };
      mrr.addEventListener('input', updateARPA);
      customers.addEventListener('input', updateARPA);

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const m = parseFloat(mrr.value) || 0, c = parseFloat(customers.value) || 0, ch = parseFloat(churn.value) || 0, ca = parseFloat(cac.value) || 0, a = parseFloat(arpa.value) || 0;
        if (m === 0 || c === 0 || ch === 0 || ca === 0) {
          error.textContent = 'Fill in MRR, customers, churn rate and CAC to calculate your metrics.';
          error.classList.remove('hidden');
          return;
        }
        error.classList.add('hidden');
        // GA4 key event — non-bot sessions only (syTrack undefined for bots).
        if ((window as any).syTrack) (window as any).syTrack('calculator_use', {});

        const ltv = a / (ch / 100);          // LTV = ARPA / monthly churn
        const ratio = ltv / ca;               // LTV:CAC
        const growthRate = (1 - ch / 100) * 100; // simplified net MRR growth
        const payback = ca / a;               // months to recover CAC

        $('ltv-value').textContent = `$${Math.round(ltv).toLocaleString()}`;
        $('ratio-value').textContent = `${ratio.toFixed(1)}:1`;
        $('growth-value').textContent = `${growthRate.toFixed(1)}%`;
        $('payback-value').textContent = `${Math.round(payback)} mo`;

        const badge = $('ratio-badge');
        const tone = ratio >= 3 ? ['Excellent', 'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-200']
          : ratio >= 2 ? ['Good', 'bg-yeti-100 text-yeti-800 dark:bg-yeti-900/50 dark:text-yeti-200']
          : ratio >= 1 ? ['Fair', 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-200']
          : ['Needs Improvement', 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-200'];
        badge.textContent = tone[0];
        badge.className = `rounded-md px-2 py-0.5 text-xs font-semibold ${tone[1]}`;

        const insights: string[] = [];
        if (ratio >= 3) insights.push("Your LTV:CAC ratio is excellent! You're efficiently acquiring customers.");
        else if (ratio < 1) insights.push("Your LTV:CAC ratio is below 1. You're spending more to acquire customers than they generate in value.");
        else insights.push('Your LTV:CAC ratio could be improved. Aim for 3:1 or higher.');
        if (ch > 5) insights.push('Your churn rate is high. Focus on retention and customer success to improve LTV.');
        else if (ch < 2) insights.push('Excellent churn rate! Your customers are sticking around.');
        if (payback > 12) insights.push('Your CAC payback period is over a year. Consider optimizing your sales efficiency.');
        else if (payback < 6) insights.push("Great payback period! You're recovering acquisition costs quickly.");
        if (a < 50) insights.push('Consider increasing prices or upselling to improve ARPA and LTV.');
        $('insights-list').innerHTML = insights.map((t) => `<li>${t}</li>`).join('');
        insightsBox.classList.remove('hidden');
        document.getElementById('results-container')!.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    })();
  </script>
</Base>
