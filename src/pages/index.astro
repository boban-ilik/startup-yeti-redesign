---
// src/pages/index.astro — homepage
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { fetchPosts } from "../lib/wordpress";

// fetchPosts retries before throwing — a throw here fails the build so Cloudflare
// keeps the previous good deployment live.
const posts = (await fetchPosts(undefined, 3)).slice(0, 3);

const topics = [
  { href: "/startup", name: "Startup" },
  { href: "/business", name: "Business" },
  { href: "/marketing", name: "Marketing" },
  { href: "/remote-work", name: "Remote Work" },
  { href: "/productivity", name: "Productivity" },
  { href: "/team-management", name: "Team Management" },
  { href: "/founder-wellbeing", name: "Founder Wellbeing" },
  { href: "/innovation", name: "Innovation" },
];
const counts = Object.fromEntries(
  await Promise.all(topics.map(async (t) => [t.name, (await fetchPosts(t.name, 500)).length]))
);

const team = [
  { name: "Boban", role: "Content & Outreach", photo: "/team/boban.webp", alt: "Boban - Content & Outreach Specialist", href: "/about",
    bio: "Six years in startup marketing and growth. Writes the marketing and business guides, and runs the research behind them." },
  { name: "Angela", role: "Content Editor", photo: "/team/angela.webp", alt: "Angela - Content Editor",
    bio: "Content editor with 10+ years in publishing. Reviews every guide for clarity and accuracy before it ships." },
  { name: "Igor", role: "Design & Tech", photo: "/team/igor.webp", alt: "Igor - Design & Tech",
    bio: "Experienced Graphic & Web Designer. 8 years of experience mentoring and teaching the next generation of designers." },
];

const title = "Startup Yeti | The Founder's Guide to Startup Growth";
const description = "StartupYeti gives early-stage founders tactical guides on marketing, pricing, operations, and remote teams. No fluff, just tactics.";
---
<Base title={title} description={description} path="">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://www.startupyeti.com/#organization",
      "name": "Startup Yeti",
      "url": "https://www.startupyeti.com",
      "logo": { "@type": "ImageObject", "url": "https://www.startupyeti.com/logo.png", "width": 200, "height": 60 },
      "description": "Startup Yeti gives early-stage founders tactical guides on marketing, pricing, operations, and remote teams.",
      "foundingDate": "2023-01-01",
      "knowsAbout": ["startups", "remote work", "productivity", "team management", "founder wellbeing", "marketing", "business strategy"],
      "sameAs": ["https://www.linkedin.com/company/startup-yeti/"]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://www.startupyeti.com/#website",
      "name": "Startup Yeti",
      "url": "https://www.startupyeti.com",
      "description": "The Founder's Guide to Startup Growth",
      "inLanguage": "en-US",
      "publisher": { "@id": "https://www.startupyeti.com/#organization" }
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="wrap pb-14 pt-16 md:pb-20 md:pt-24">
    <div class="max-w-3xl">
      <h1 class="display text-4xl leading-[1.08] sm:text-5xl lg:text-6xl">
        The Founder's Guide to Startup Growth
      </h1>
      <p class="lead mt-6 max-w-2xl">
        StartupYeti gives early-stage founders tactical guides on marketing, pricing, operations, and remote teams. No fluff, just tactics.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/blog" data-sy-cta="hero-explore-guides" class="btn-primary btn-lg">Explore Our Guides</a>
        <a href="/resources" class="btn-secondary btn-lg">Start Building Better →</a>
      </div>
      <ul class="meta mt-8 flex flex-wrap gap-x-5 gap-y-1.5">
        <li>100+ Tactical Guides</li>
        <li>Proven Frameworks</li>
        <li>Built by Founders</li>
      </ul>
    </div>
  </section>

  <!-- Topics -->
  <section class="wrap border-t border-slate-200 py-10 dark:border-slate-800" aria-labelledby="topics-heading">
    <h2 id="topics-heading" class="text-sm font-semibold text-slate-900 dark:text-white">Explore Topics</h2>
    <ul class="mt-4 flex flex-wrap gap-x-7 gap-y-3">
      {topics.map((t) => (
        <li>
          <a href={t.href} class="group inline-flex items-baseline gap-2 text-base font-medium text-slate-700 hover:text-yeti-700 dark:text-slate-200 dark:hover:text-yeti-400">
            {t.name}
            <span class="text-sm tabular-nums text-slate-500 group-hover:text-yeti-700 dark:text-slate-400 dark:group-hover:text-yeti-400">{counts[t.name]}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Built by founders -->
  <section class="border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900">
    <div class="wrap section grid gap-12 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-7">
        <h2 class="display text-3xl md:text-4xl lg:text-5xl">Built by Founders,<br />for Founders.</h2>
        <p class="lead mt-6">
          StartupYeti wasn't built by content marketers. It was created by a team that lives this daily. We run remote teams, build SaaS products, and use EOS to keep operations tight.
        </p>
        <blockquote class="mt-8 border-t border-slate-300 pt-6 font-serif text-xl leading-relaxed text-slate-800 md:text-2xl dark:border-slate-700 dark:text-slate-100">
          "Every article, framework, and resource on this site comes from real experience scaling startups — not recycled advice from business school textbooks."
        </blockquote>
      </div>
      <dl class="grid grid-cols-2 gap-x-6 gap-y-8 self-start md:col-span-5 md:pt-2">
        {[["8", "Core Topics"], ["100+", "Guides"], ["100%", "Remote"], ["SaaS", "Focused"]].map(([n, l]) => (
          <div class="border-t border-slate-300 pt-4 dark:border-slate-700">
            <dt class="text-sm text-slate-600 dark:text-slate-300">{l}</dt>
            <dd class="display mt-1 text-3xl md:text-4xl">{n}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Team -->
  <section class="wrap section" aria-labelledby="team-heading">
    <div class="max-w-2xl">
      <h2 id="team-heading" class="display text-3xl md:text-4xl">Meet the Team</h2>
      <p class="lead mt-4">Passionate writers and researchers dedicated to helping startups succeed.</p>
    </div>
    <ul class="mt-10 grid gap-10 border-t border-slate-200 pt-10 sm:grid-cols-3 dark:border-slate-800">
      {team.map((m) => (
        <li>
          <img src={m.photo} alt={m.alt} width="240" height="240" loading="lazy" decoding="async" class="h-20 w-20 rounded-full object-cover" />
          <h3 class="mt-5 text-lg font-semibold text-slate-900 dark:text-white">
            {m.href ? <a href={m.href} class="hover:text-yeti-700 dark:hover:text-yeti-400">{m.name}</a> : m.name}
          </h3>
          <p class="label mt-0.5 normal-case tracking-normal">{m.role}</p>
          <p class="mt-3 text-slate-600 dark:text-slate-300">{m.bio}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- SaaS calculator -->
  <section class="border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900">
    <div class="wrap section grid gap-12 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-7">
        <h2 class="display text-3xl md:text-4xl">Calculate Your SaaS Metrics in Seconds</h2>
        <p class="lead mt-5">
          Get instant insights into your Customer Lifetime Value, LTV:CAC ratio, growth rate, and payback period. Make data-driven decisions to scale your SaaS business.
        </p>
        <ul class="mt-8 space-y-4">
          {[
            ["Instant Calculations", "Get your metrics in real-time with smart insights"],
            ["Actionable Insights", "Personalized recommendations to improve your metrics"],
            ["No Signup Required", "100% free, forever. Start calculating immediately"],
          ].map(([t, d]) => (
            <li class="flex gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-yeti-700 dark:text-yeti-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <div>
                <p class="font-semibold text-slate-900 dark:text-white">{t}</p>
                <p class="text-sm text-slate-600 dark:text-slate-300">{d}</p>
              </div>
            </li>
          ))}
        </ul>
        <a href="/calculator" data-sy-cta="home-try-calculator" class="btn-primary btn-lg mt-8">Try Calculator Now</a>
      </div>
      <div class="md:col-span-5 md:pt-2">
        <p class="text-sm font-semibold text-slate-900 dark:text-white">What it calculates</p>
        <ol class="mt-4 divide-y divide-slate-200 border-y border-slate-200 dark:divide-slate-800 dark:border-slate-800">
          {["Customer Lifetime Value", "LTV:CAC Ratio", "Net MRR Growth Rate", "CAC Payback Period"].map((m, i) => (
            <li class="flex items-baseline gap-4 py-3.5">
              <span class="w-6 text-sm tabular-nums text-slate-500 dark:text-slate-400">{i + 1}</span>
              <span class="font-medium text-slate-800 dark:text-slate-100">{m}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Recent insights -->
  <section class="wrap section" aria-labelledby="recent-heading">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="recent-heading" class="display text-3xl md:text-4xl">Recent Insights</h2>
        <p class="lead mt-2">Tactical advice for the modern founder.</p>
      </div>
      <a href="/blog" class="link">View all articles →</a>
    </div>
    {posts.length > 0 ? (
      <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => {
          const cat = post.categories.nodes[0];
          const img = post.featuredImage?.node;
          return (
            <PostCard
              href={`/${cat?.slug || "blog"}/${post.slug}`}
              title={post.title}
              excerpt={post.excerpt}
              date={post.date}
              categoryName={cat?.name}
              categoryHref={cat ? `/${cat.slug}` : undefined}
              image={img ? { src: img.sourceUrl, srcset: img.srcset, alt: img.altText, width: img.mediaDetails.width, height: img.mediaDetails.height } : null}
            />
          );
        })}
      </div>
    ) : (
      <p class="mt-10 text-slate-600 dark:text-slate-300">No articles yet.</p>
    )}
  </section>
</Base>
