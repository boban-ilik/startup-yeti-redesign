---
// src/pages/[category]/[slug].astro
// Dynamic blog post page matching existing URL structure: /category/slug/
import { DEPRECATED_CATEGORY_REMAP } from "../../lib/wordpress";
import { isNoIndex, isRedirected } from "../../data/noindex.js";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import NewsletterCta from "../../components/NewsletterCta.astro";
import { buildSrcset, SIZES } from "../../lib/images";

// 1. Get all paths with ALL data pre-fetched — eliminates per-post API calls
export async function getStaticPaths() {
  // Helper: fetch with retry logic
  async function fetchWithRetry(url, options = {}, retries = 3) {
    for (let i = 0; i < retries; i++) {
      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 30000);
        const response = await fetch(url, { ...options, signal: controller.signal });
        clearTimeout(timeout);
        if (response.ok) return response;
        if (i < retries - 1) {
          console.log(`Attempt ${i + 1} failed, retrying...`);
          await new Promise(resolve => setTimeout(resolve, 1000 * (i + 1)));
        }
      } catch (error) {
        if (i < retries - 1) {
          console.log(`Attempt ${i + 1} failed: ${error.message}, retrying...`);
          await new Promise(resolve => setTimeout(resolve, 1000 * (i + 1)));
        } else {
          throw error;
        }
      }
    }
    throw new Error(`Failed after ${retries} attempts`);
  }

  // Helper: decode HTML entities in titles
  function decodeHtmlEntities(text) {
    const entities = {
      '&#8217;': "'", '&#8216;': "'", '&#8220;': '"', '&#8221;': '"',
      '&#8211;': '–', '&#8212;': '—', '&#038;': '&', '&amp;': '&',
      '&lt;': '<', '&gt;': '>', '&quot;': '"', '&apos;': "'", '&#39;': "'"
    };
    return text.replace(/&#?\w+;/g, entity => entities[entity] || entity);
  }

  // Local team photos beat Gravatar (the WP users have no Gravatar set, which
  // renders an empty grey circle). Unknown authors fall back to their WP
  // avatar URL if one exists.
  const LOCAL_AVATARS = {
    'Boban Ilik': '/team/boban.jpg',
  };

  // Helper: transform raw WP REST post into template-ready shape
  function transformPost(rawPost) {
    return {
      id: rawPost.id,
      slug: rawPost.slug,
      title: decodeHtmlEntities(rawPost.title.rendered),
      content: rawPost.content.rendered,
      date: rawPost.date,
      modified: rawPost.modified || rawPost.date,
      // Decoded like the title: excerpts feed related-post cards and the meta
      // description, where a raw &#8217; renders as literal text once escaped.
      excerpt: decodeHtmlEntities(rawPost.excerpt.rendered),
      categoryId: rawPost.categories[0],
      featuredImage: rawPost._embedded?.['wp:featuredmedia']?.[0] ? (() => {
        const m = rawPost._embedded['wp:featuredmedia'][0];
        const width = m.media_details?.width || 1200;
        const height = m.media_details?.height || 630;
        return {
          node: {
            sourceUrl: m.source_url,
            altText: m.alt_text || rawPost.title.rendered,
            width, height,
            srcset: buildSrcset(m.media_details?.sizes, { url: m.source_url, width, height })
          }
        };
      })() : null,
      author: {
        node: {
          name: rawPost._embedded?.author?.[0]?.name || 'Startup Yeti',
          avatar: {
            url: LOCAL_AVATARS[rawPost._embedded?.author?.[0]?.name] ||
              rawPost._embedded?.author?.[0]?.avatar_urls?.['96'] || ''
          }
        }
      },
      categories: {
        nodes: (rawPost._embedded?.['wp:term']?.[0] || []).map(cat => {
          const remap = DEPRECATED_CATEGORY_REMAP[(cat.slug || '').toLowerCase()];
          return remap
            ? { name: remap.name, slug: remap.slug }
            : { name: cat.name, slug: cat.slug };
        })
      },
      tags: {
        nodes: (rawPost._embedded?.['wp:term']?.[1] || []).map(tag => ({
          name: tag.name
        }))
      }
    };
  }

  const WORDPRESS_BASE = "https://admin.startupyeti.com";

  try {
    // Fetch all categories once for ID→slug/name mapping
    const categoriesResponse = await fetchWithRetry(
      `${WORDPRESS_BASE}/wp-json/wp/v2/categories?per_page=100&_fields=id,slug,name`,
      { headers: { "User-Agent": "StartupYeti/1.0 (Astro Static Site Generator)" } }
    );
    const categories = await categoriesResponse.json();
    // Remap deprecated WP categories to active ones so their posts generate
    // at live URLs (e.g. /business/{slug}) instead of redirect-shadowed paths
    // like /sales/{slug}. See DEPRECATED_CATEGORY_REMAP in lib/wordpress.ts.
    const categoryMap = Object.fromEntries(categories.map(c => {
      const remap = DEPRECATED_CATEGORY_REMAP[c.slug.toLowerCase()];
      return [c.id, remap ? { slug: remap.slug, name: remap.name } : { slug: c.slug, name: c.name }];
    }));

    // Fetch ALL posts with full data + embedded media/author/terms in one paginated pass.
    // This replaces ~N individual per-post API calls with ceil(N/100) requests total.
    let allRawPosts = [];
    let page = 1;
    let hasMore = true;

    console.log(`Fetching all posts with embedded data from: ${WORDPRESS_BASE}`);

    while (hasMore) {
      const url = `${WORDPRESS_BASE}/wp-json/wp/v2/posts?per_page=100&page=${page}&status=publish&_embed&_fields=id,slug,title,content,excerpt,date,modified,categories,_links,_embedded`;
      try {
        const response = await fetchWithRetry(url, {
          headers: { "User-Agent": "StartupYeti/1.0 (Astro Static Site Generator)" }
        });
        const posts = await response.json();
        allRawPosts.push(...posts);
        console.log(`Fetched page ${page}: ${posts.length} posts`);
        const totalPages = parseInt(response.headers.get('X-WP-TotalPages') || '1');
        hasMore = page < totalPages;
        page++;
      } catch (error) {
        console.error(`Failed to fetch page ${page}:`, error.message);
        break;
      }
    }

    console.log(`✅ Fetched ${allRawPosts.length} posts total (${page - 1} paginated API calls)`);

    if (allRawPosts.length === 0) {
      console.warn('No posts found in WordPress.');
      return [];
    }

    // Transform all posts into template-ready shape.
    // Pruned posts that are 301'd elsewhere are dropped here so no static asset
    // is generated (an asset would take precedence over the _redirects rule).
    const allPosts = allRawPosts.map(transformPost).filter((post) => {
      const catInfo = categoryMap[post.categoryId] || { slug: 'uncategorized' };
      return !isRedirected(catInfo.slug.toLowerCase(), post.slug);
    });

    // Build one static path per post with all data pre-computed as props
    return allPosts.map((post) => {
      const catInfo = categoryMap[post.categoryId] || { slug: 'uncategorized', name: 'Uncategorized' };
      const categorySlug = catInfo.slug.toLowerCase();

      // Related posts: same category, exclude self, most recent 3
      const relatedPosts = allPosts
        .filter(p => p.id !== post.id && p.categoryId === post.categoryId)
        .slice(0, 3)
        .map(p => ({
          slug: p.slug,
          title: p.title,
          excerpt: p.excerpt.replace(/<[^>]*>/g, '').substring(0, 120) + '...',
          date: p.date,
          image: p.featuredImage ? { src: p.featuredImage.node.sourceUrl, srcset: p.featuredImage.node.srcset, alt: p.featuredImage.node.altText, width: p.featuredImage.node.width, height: p.featuredImage.node.height } : null,
          category: categorySlug
        }));

      // Cross-category posts: different category, exclude self, most recent 4
      const crossCategoryPosts = allPosts
        .filter(p => p.id !== post.id && p.categoryId !== post.categoryId)
        .slice(0, 4)
        .map(p => {
          const pCatInfo = categoryMap[p.categoryId] || { slug: 'blog', name: 'Blog' };
          return {
            slug: p.slug,
            title: p.title,
            excerpt: p.excerpt.replace(/<[^>]*>/g, '').substring(0, 100) + '...',
            date: p.date,
            image: p.featuredImage ? { src: p.featuredImage.node.sourceUrl, srcset: p.featuredImage.node.srcset, alt: p.featuredImage.node.altText, width: p.featuredImage.node.width, height: p.featuredImage.node.height } : null,
            category: pCatInfo.slug,
            categoryName: pCatInfo.name
          };
        });

      return {
        params: { category: categorySlug, slug: post.slug },
        props: { post, relatedPosts, crossCategoryPosts }
      };
    });
  } catch (error) {
    console.error('Error in getStaticPaths:', error);
    return [];
  }
}

// 2. Read pre-fetched data from props — zero API calls at page render time
const { post, relatedPosts, crossCategoryPosts } = Astro.props;
const { category, slug } = Astro.params;

// Calculate reading time
const wordCount = post.content.replace(/<[^>]*>/g, '').split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

// SEO data
const siteUrl = "https://www.startupyeti.com";
const pageUrl = `${siteUrl}/${category}/${slug}`;
const metaDescription = post.excerpt.replace(/<[^>]*>/g, '').substring(0, 160);
const metaTitle = `${post.title} | Startup Yeti`;
const ogImage = post.featuredImage?.node?.sourceUrl || `${siteUrl}/og-default.png`;

// Thin legacy posts excluded from indexing (see src/data/noindex.js).
// "follow" is deliberate: internal links still pass through these pages.
const robotsDirective = isNoIndex(category, slug)
  ? "noindex, follow, max-image-preview:large"
  : "index, follow, max-image-preview:large";
const publishedDate = new Date(post.date).toISOString();
const modifiedDate = new Date(post.modified || post.date).toISOString();
const categoryName = post.categories.nodes[0]?.name || 'Article';
---

<Base
  title={metaTitle}
  description={metaDescription}
  path={`/${category}/${slug}`}
  ogType="article"
  ogImage={ogImage}
  robots={robotsDirective}
  preloadImage={post.featuredImage?.node?.sourceUrl}
  progress
>
  <Fragment slot="head">
    <meta name="author" content={post.author.node.name} />
    <meta property="article:published_time" content={publishedDate} />
    <meta property="article:modified_time" content={modifiedDate} />
    <meta property="article:author" content={`${siteUrl}/about`} />
    <meta property="article:section" content={categoryName} />
    {post.tags.nodes.map((tag) => <meta property="article:tag" content={tag.name} />)}

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "@id": `${pageUrl}#article`,
      "headline": post.title,
      "description": metaDescription,
      "image": [
        { "@type": "ImageObject", "url": ogImage, "width": 1200, "height": 675 },
        { "@type": "ImageObject", "url": ogImage, "width": 1200, "height": 900 },
        { "@type": "ImageObject", "url": ogImage, "width": 1200, "height": 1200 }
      ],
      "datePublished": publishedDate,
      "dateModified": modifiedDate,
      "author": { "@type": "Person", "@id": `${siteUrl}/about#person`, "name": post.author.node.name, "url": `${siteUrl}/about`, "sameAs": ["https://www.linkedin.com/in/bobanilik/"] },
      "publisher": { "@type": "Organization", "@id": `${siteUrl}/#organization`, "name": "Startup Yeti", "url": siteUrl, "logo": { "@type": "ImageObject", "url": `${siteUrl}/logo.png`, "width": 200, "height": 60 }, "sameAs": ["https://www.linkedin.com/company/startup-yeti/"] },
      "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
      "articleSection": categoryName,
      "keywords": post.tags.nodes.map(tag => tag.name).join(', '),
      "wordCount": wordCount,
      "timeRequired": `PT${readingTime}M`,
      "inLanguage": "en-US"
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": categoryName, "item": `${siteUrl}/${category}` },
        { "@type": "ListItem", "position": 3, "name": post.title, "item": pageUrl }
      ]
    })} />
  </Fragment>

  <!-- Article header -->
  <header class="wrap-narrow pt-12 md:pt-16">
    <nav aria-label="Breadcrumb" class="meta">
      <a href="/" class="hover:text-slate-900 dark:hover:text-white">Home</a>
      <span aria-hidden="true" class="mx-1.5">/</span>
      <a href={`/${category}`} class="hover:text-slate-900 dark:hover:text-white">{categoryName}</a>
    </nav>
    <h1 class="display mt-5 text-3xl leading-[1.12] sm:text-4xl md:text-5xl">{post.title}</h1>
    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-slate-200 pb-6 dark:border-slate-800">
      <div class="flex items-center gap-3">
        {post.author.node.avatar?.url && (
          <img src={post.author.node.avatar.url} alt="" width="96" height="96" class="h-10 w-10 rounded-full object-cover" />
        )}
        <div class="text-sm">
          <p class="font-semibold text-slate-900 dark:text-white">{post.author.node.name}</p>
          <p class="meta">
            <time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <span aria-hidden="true"> · </span>{readingTime} min read
          </p>
        </div>
      </div>
    </div>
  </header>

  {post.featuredImage && (
    <figure class="wrap-narrow mt-8">
      <img
        src={post.featuredImage.node.sourceUrl}
        srcset={post.featuredImage.node.srcset}
        sizes={SIZES.hero}
        alt={post.featuredImage.node.altText || post.title}
        width={post.featuredImage.node.width}
        height={post.featuredImage.node.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-[1200/630] w-full rounded-lg object-cover"
      />
    </figure>
  )}

  <!-- Article body -->
  <section class="wrap-narrow pb-12 pt-10 md:pb-16">
    <article class="prose prose-lg dark:prose-invert" set:html={post.content} />
  </section>

  <!-- Resource CTA — injected via template, appears on all posts -->
  <section class="wrap-narrow pb-12">
    <div class="rounded-lg border border-yeti-200 bg-yeti-50 p-6 sm:p-8 dark:border-yeti-900 dark:bg-yeti-950/40">
      <h2 class="display text-2xl">Is Your PLG Funnel Leaking?</h2>
      <p class="mt-3 text-slate-700 dark:text-slate-300">
        Take our free 10-question self-audit to find exactly where your product-led growth is stalling — and whether brand-led growth is the fix.
      </p>
      <a href="/resources/plg-brand-audit-checklist" class="btn-primary mt-5">Take the Free Audit →</a>
    </div>
  </section>

  {post.tags.nodes.length > 0 && (
    <section class="wrap-narrow pb-12" aria-label="Tags">
      <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Tags</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {post.tags.nodes.map((tag) => (
          <li class="rounded-md border border-slate-200 px-3 py-1.5 text-sm text-slate-700 dark:border-slate-700 dark:text-slate-200">{tag.name}</li>
        ))}
      </ul>
    </section>
  )}

  {relatedPosts.length > 0 && (
    <section class="border-t border-slate-200 dark:border-slate-800" aria-labelledby="related-heading">
      <div class="wrap section">
        <h2 id="related-heading" class="display text-3xl md:text-4xl">Related Articles</h2>
        <p class="lead mt-2">Continue exploring more insights in {categoryName}</p>
        <ul class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {relatedPosts.map((r) => (
            <PostCard as="li" href={`/${r.category}/${r.slug}`} title={r.title} excerpt={r.excerpt} date={r.date} image={r.image} />
          ))}
        </ul>
        <a href={`/${category}`} class="link mt-10 inline-block">View all {categoryName} articles →</a>
      </div>
    </section>
  )}

  {crossCategoryPosts.length > 0 && (
    <section class="border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900" aria-labelledby="more-heading">
      <div class="wrap section">
        <h2 id="more-heading" class="display text-3xl md:text-4xl">More from Startup Yeti</h2>
        <p class="lead mt-2">Explore insights across all our topics</p>
        <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {crossCategoryPosts.map((p) => (
            <PostCard as="li" compact href={`/${p.category}/${p.slug}`} title={p.title} categoryName={p.categoryName} categoryHref={`/${p.category}`} image={p.image} />
          ))}
        </ul>
        <a href="/blog" class="link mt-10 inline-block">Browse all articles →</a>
      </div>
    </section>
  )}

  <NewsletterCta heading="Get More Tactical Advice" body="Get weekly insights on building and growing your startup. No spam, unsubscribe anytime." />
</Base>
