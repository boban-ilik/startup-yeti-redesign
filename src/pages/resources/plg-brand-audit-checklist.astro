---
// src/pages/resources/plg-brand-audit-checklist.astro
import Base from "../../layouts/Base.astro";

const siteUrl = "https://www.startupyeti.com";
const pageUrl = `${siteUrl}/resources/plg-brand-audit-checklist`;
const title = "PLG + Brand Audit: 10 Questions to Diagnose Your Growth Ceiling | Startup Yeti";
const description = "A free self-audit for SaaS founders to pinpoint exactly where their product-led growth is stalling — and whether brand-led growth is the fix.";

const sections = [
  {
    id: "plg",
    label: "Section 1 of 3",
    title: "PLG Health Check",
    subtitle: "Diagnose your product-led funnel",
    items: [
      {
        id: "q1",
        text: "Our free-to-paid conversion rate is consistently above 3%",
        note: "Industry benchmark is 3–5%. Below that signals activation or positioning gaps — not just a product problem.",
      },
      {
        id: "q2",
        text: "We have a clearly defined 'aha moment' and actively measure time-to-value",
        note: "If you can't name the exact moment, your onboarding isn't engineered around it.",
      },
      {
        id: "q3",
        text: "Churn happens mostly before activation — not after users see value",
        note: "Post-activation churn is usually a brand and trust problem, not a product problem.",
      },
      {
        id: "q4",
        text: "Our customer acquisition cost (CAC) has been stable or declining over the past 6 months",
        note: "Rising CAC in a PLG model signals self-serve virality is saturating and you need brand pull.",
      },
    ],
  },
  {
    id: "brand",
    label: "Section 2 of 3",
    title: "Brand Readiness",
    subtitle: "Assess your positioning and differentiation",
    items: [
      {
        id: "q5",
        text: "We can articulate our brand positioning in one sentence — without using the word 'easy'",
        note: "If your positioning sounds like every competitor's, it isn't positioning.",
      },
      {
        id: "q6",
        text: "We know why prospects choose competitors — and the reason isn't just features",
        note: "Feature parity means brand is the deciding factor. Without win/loss data, you're guessing.",
      },
      {
        id: "q7",
        text: "Our brand narrative appears inside the product: onboarding, tooltips, and empty states",
        note: "Brand-led PLG embeds positioning into every product touchpoint — not just marketing pages.",
      },
      {
        id: "q8",
        text: "Our branded search volume is growing month-over-month",
        note: "Brand awareness shows up in branded search volume before it shows up in revenue.",
      },
    ],
  },
  {
    id: "integration",
    label: "Section 3 of 3",
    title: "Integration Readiness",
    subtitle: "Check if PLG and brand are working together",
    items: [
      {
        id: "q9",
        text: "Product and marketing share KPIs and align on strategy at least monthly",
        note: "Siloed teams are the #1 reason PLG and brand never compound into durable growth.",
      },
      {
        id: "q10",
        text: "Product usage data informs our brand messaging on a regular cadence",
        note: "Your best customers' behavior patterns are your best brand stories. Are you mining them?",
      },
    ],
  },
];

const allItems = sections.flatMap(s => s.items);
---

<Base title={title} description={description} path="/resources/plg-brand-audit-checklist">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "PLG + Brand Audit: 10 Questions to Diagnose Your Growth Ceiling",
      "description": description,
      "url": pageUrl,
      "publisher": { "@type": "Organization", "name": "Startup Yeti", "url": siteUrl },
      "step": allItems.map((item, i) => ({ "@type": "HowToStep", "position": i + 1, "name": item.text, "text": item.note }))
    })} />
    <style is:global>
      @page { size: A4; margin: 1.5cm 1.8cm; }
      @media screen { .print-only { display: none !important; } }
      .audit-checkbox { appearance: none; -webkit-appearance: none; width: 1.375rem; height: 1.375rem; border: 2px solid #94a3b8; border-radius: 0.375rem; cursor: pointer; flex-shrink: 0; position: relative; background: transparent; }
      .audit-checkbox:checked { background: #0369a1; border-color: #0369a1; }
      .dark .audit-checkbox:checked { background: #38bdf8; border-color: #38bdf8; }
      .audit-checkbox:checked::after { content: ''; position: absolute; left: 5px; top: 2px; width: 8px; height: 5px; border: 2.5px solid white; border-top: none; border-right: none; transform: rotate(-45deg); }
      .dark .audit-checkbox:checked::after { border-color: #020617; }
      .checklist-item.checked .item-text { text-decoration: line-through; text-decoration-color: #94a3b8; opacity: 0.7; }
      @media print {
        * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        .no-print, #site-header, footer, #reading-progress { display: none !important; }
        .print-only { display: block !important; }
        html, body { background: white !important; }
        body { font-size: 9.5pt; line-height: 1.45; color: #1e293b !important; margin: 0; padding: 0; }
        main { padding-top: 0 !important; }
        .print-header { display: flex !important; align-items: center; justify-content: space-between; padding-bottom: 9pt; margin-bottom: 12pt; border-bottom: 2.5pt solid #0369a1; }
        .hero-section { padding: 0 0 12pt 0 !important; border: none !important; }
        .hero-actions, .hero-source, .score-widget { display: none !important; }
        .hero-section h1 { font-size: 17pt !important; color: #0c4a6e !important; margin: 0 0 4pt 0 !important; line-height: 1.2 !important; }
        .hero-desc { font-size: 9pt !important; color: #475569 !important; margin: 0 !important; }
        .checklist-section { break-inside: avoid; page-break-inside: avoid; margin-bottom: 10pt !important; border: 1pt solid #cbd5e1 !important; border-radius: 5pt !important; }
        .section-hdr { padding: 7pt 11pt !important; border-bottom: 1pt solid #cbd5e1; }
        .section-label { font-size: 7pt !important; letter-spacing: 0.05em; }
        .section-hdr h2 { font-size: 11.5pt !important; margin: 2pt 0 1pt 0 !important; }
        .section-subtitle { font-size: 8pt !important; }
        .checklist-item { padding: 7pt 11pt !important; cursor: default !important; break-inside: avoid; page-break-inside: avoid; }
        .audit-checkbox { -webkit-appearance: checkbox !important; appearance: checkbox !important; width: 11pt !important; height: 11pt !important; border: none !important; background: transparent !important; margin-top: 1pt; }
        .item-text { font-size: 9.5pt !important; font-weight: 600; }
        .item-note { font-size: 8pt !important; margin-top: 2pt !important; color: #64748b !important; }
        .q-num { display: inline-flex !important; align-items: center; justify-content: center; width: 14pt; height: 14pt; border-radius: 50%; background: #e0f2fe !important; color: #0369a1 !important; font-size: 7pt !important; font-weight: 700; flex-shrink: 0; margin-top: 1pt; }
        .print-score { display: block !important; break-inside: avoid; margin-top: 10pt; padding: 10pt 14pt; border: 1.5pt solid #0369a1; border-radius: 5pt; background: #f0f9ff !important; }
        .print-score-title { font-size: 11pt; font-weight: 700; color: #0c4a6e; margin-bottom: 4pt; }
        .print-score-key { font-size: 8.5pt; color: #475569; margin-bottom: 3pt; }
        .print-score-url { font-size: 7.5pt; color: #94a3b8; margin-top: 4pt; }
        .print-footer { display: flex !important; justify-content: space-between; margin-top: 12pt; padding-top: 7pt; border-top: 0.75pt solid #e2e8f0; font-size: 7.5pt; color: #94a3b8; }
      }
    </style>
  </Fragment>

  <!-- Print-only header (hidden on screen, shown in PDF) -->
  <div class="print-header print-only">
    <img src="/logo.png" alt="Startup Yeti" style="height:30pt; object-fit:contain" />
    <div style="text-align:right; font-size:8pt; color:#64748b; line-height:1.6">
      <div style="font-weight:700; color:#0c4a6e">PLG + Brand Audit Checklist</div>
      <div>startupyeti.com/resources/plg-brand-audit-checklist</div>
      <div id="print-date"></div>
    </div>
  </div>

  <section class="hero-section wrap-narrow border-b border-slate-200 pb-10 pt-12 md:pt-16 dark:border-slate-800">
    <h1 class="display text-4xl md:text-5xl">PLG + Brand Audit</h1>
    <p class="hero-desc lead mt-5">10 questions that reveal exactly where your product-led growth is stalling — and whether brand-led growth is the missing layer.</p>
    <p class="hero-source meta mt-3">Based on our deep-dive: <a href="/startup/why-your-plg-strategy-will-stall-and-how-brand-led-growth-fixes-it" class="link">Why Your PLG Strategy Will Stall</a></p>
    <div class="hero-actions mt-6 flex flex-wrap gap-3">
      <button type="button" onclick="window.print()" class="btn-primary">Save as PDF</button>
      <a href="/startup/why-your-plg-strategy-will-stall-and-how-brand-led-growth-fixes-it" class="btn-secondary">← Back to article</a>
    </div>

    <div class="score-widget no-print mt-8 max-w-sm rounded-lg border border-slate-200 p-5 dark:border-slate-800">
      <div class="flex items-center justify-between">
        <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Your Score</span>
        <span id="score-label" class="text-sm font-semibold tabular-nums text-slate-900 dark:text-white">0 / 10</span>
      </div>
      <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
        <div id="score-bar" class="h-full rounded-full bg-yeti-700 dark:bg-yeti-400" style="width: 0%"></div>
      </div>
      <p id="score-message" class="meta mt-3">Check each statement that's true for your company →</p>
    </div>
  </section>

  <section class="wrap-narrow space-y-10 py-12">
    {(() => {
      let qNum = 0;
      return sections.map((section) => (
        <div class="checklist-section rounded-lg border border-slate-200 dark:border-slate-800">
          <div class="section-hdr border-b border-slate-200 px-5 py-4 sm:px-6 dark:border-slate-800">
            <span class="section-label meta">{section.label}</span>
            <h2 class="display mt-1 text-xl">{section.title}</h2>
            <p class="section-subtitle mt-0.5 text-sm text-slate-600 dark:text-slate-300">{section.subtitle}</p>
          </div>
          <div class="divide-y divide-slate-200 dark:divide-slate-800">
            {section.items.map((item) => {
              qNum++;
              const currentQ = qNum;
              return (
                <label for={item.id} class="checklist-item flex cursor-pointer items-start gap-4 px-5 py-5 hover:bg-slate-50 sm:px-6 dark:hover:bg-slate-900" data-item-id={item.id}>
                  <input type="checkbox" id={item.id} class="audit-checkbox mt-0.5" data-item={item.id} />
                  <span class="q-num print-only">Q{currentQ}</span>
                  <span class="min-w-0 flex-1">
                    <span class="item-text block font-semibold leading-snug text-slate-900 dark:text-white">{item.text}</span>
                    <span class="item-note mt-1.5 block text-sm leading-relaxed text-slate-600 dark:text-slate-300">{item.note}</span>
                  </span>
                </label>
              );
            })}
          </div>
        </div>
      ));
    })()}
  </section>

  <section class="no-print wrap-narrow pb-20">
    <div id="result-card" class="rounded-lg border border-slate-200 p-6 sm:p-8 dark:border-slate-800" aria-live="polite">
      <h2 id="result-title" class="display text-2xl">Complete the audit above</h2>
      <p id="result-body" class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">Check each statement that's true for your company. Your results and recommended next steps will appear here.</p>
      <div id="result-cta" class="mt-6 hidden">
        <a href="/startup/why-your-plg-strategy-will-stall-and-how-brand-led-growth-fixes-it" class="btn-primary">Read the full PLG + Brand playbook →</a>
      </div>
    </div>
  </section>

  <div class="print-score print-only">
    <div class="print-score-title">Your Score: <span id="print-score">—</span> / 10 <span id="print-score-badge" style="margin-left:8pt; font-size:9pt; font-weight:400"></span></div>
    <div class="print-score-key">8–10: Strong foundation — ready to compound &nbsp;·&nbsp; 5–7: Warning signs — tighten the integration &nbsp;·&nbsp; 0–4: Critical gaps — PLG ceiling is brand-related</div>
    <div class="print-score-url">Full playbook: startupyeti.com/startup/why-your-plg-strategy-will-stall-and-how-brand-led-growth-fixes-it</div>
  </div>
  <div class="print-footer print-only">
    <span>© {new Date().getFullYear()} Startup Yeti · startupyeti.com</span>
    <span>Free resource — share freely</span>
  </div>

  <script is:inline>
    (function () {
      var STORAGE_KEY = 'plg-audit-checklist';
      var TOTAL = 10;
      var scoreBar = document.getElementById('score-bar');
      var scoreLabel = document.getElementById('score-label');
      var scoreMsg = document.getElementById('score-message');
      var resultCard = document.getElementById('result-card');
      var resultTitle = document.getElementById('result-title');
      var resultBody = document.getElementById('result-body');
      var resultCta = document.getElementById('result-cta');
      var printScore = document.getElementById('print-score');
      var printBadge = document.getElementById('print-score-badge');
      var printDate = document.getElementById('print-date');
      if (printDate) printDate.textContent = 'Generated ' + new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

      var results = [
        { min: 8, title: 'Strong Foundation — Ready to Compound', body: 'Your PLG health and brand readiness are solid. The opportunity now is compounding: use brand to lower CAC while product virality drives activation. Focus on shared KPIs and shortening your feedback loop.', card: 'border-yeti-300 bg-yeti-50 dark:border-yeti-800 dark:bg-yeti-950/40', bar: 'bg-yeti-700 dark:bg-yeti-400', badge: 'Strong foundation' },
        { min: 5, title: 'Warning Signs — Time to Tighten the Integration', body: "You have real strengths but identifiable gaps. Look at the unchecked items — they're likely where you're leaving growth on the table. Brand-PLG integration is probably missing in 1–2 specific areas.", card: 'border-amber-300 bg-amber-50 dark:border-amber-800 dark:bg-amber-950/40', bar: 'bg-amber-500', badge: 'Warning signs' },
        { min: 0, title: 'Critical Gaps — Your PLG Ceiling Is Likely Brand-Related', body: "Multiple foundational issues are present. The good news: these are solvable, and fixing them compounds. Start with one unchecked item per section — don't try to fix everything at once.", card: 'border-red-300 bg-red-50 dark:border-red-900 dark:bg-red-950/40', bar: 'bg-red-500', badge: 'Critical gaps' }
      ];
      var BASE_CARD = 'rounded-lg border p-6 sm:p-8 ';
      function getScore() { return document.querySelectorAll('.audit-checkbox:checked').length; }
      function updateUI() {
        var score = getScore();
        var r = results.find(function (x) { return score >= x.min; });
        scoreBar.style.width = (score / TOTAL) * 100 + '%';
        scoreBar.className = 'h-full rounded-full ' + r.bar;
        scoreLabel.textContent = score + ' / ' + TOTAL;
        scoreMsg.textContent = score === 0 ? "Check each statement that's true for your company →" : score + ' of 10 items checked';
        if (printScore) printScore.textContent = score;
        if (printBadge) printBadge.textContent = r.badge;
        if (score === 0) {
          resultCard.className = BASE_CARD + 'border-slate-200 dark:border-slate-800';
          resultTitle.textContent = 'Complete the audit above';
          resultBody.textContent = "Check each statement that's true for your company. Your results and recommended next steps will appear here.";
          resultCta.classList.add('hidden');
          return;
        }
        resultCard.className = BASE_CARD + r.card;
        resultTitle.textContent = r.title;
        resultBody.textContent = r.body;
        resultCta.classList.remove('hidden');
      }
      function updateItemStyle(cb) {
        var label = document.querySelector('[for="' + cb.id + '"]') || cb.closest('label');
        if (label) label.classList.toggle('checked', cb.checked);
      }
      function saveState() {
        var state = {};
        document.querySelectorAll('.audit-checkbox').forEach(function (cb) { state[cb.id] = cb.checked; });
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
      }
      function loadState() {
        try {
          var raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return;
          var state = JSON.parse(raw);
          document.querySelectorAll('.audit-checkbox').forEach(function (cb) { if (state[cb.id]) { cb.checked = true; updateItemStyle(cb); } });
        } catch (e) {}
      }
      document.querySelectorAll('.audit-checkbox').forEach(function (cb) {
        cb.addEventListener('change', function () { updateItemStyle(cb); updateUI(); saveState(); });
      });
      window.addEventListener('beforeprint', updateUI);
      loadState();
      updateUI();
    })();
  </script>
</Base>
