---
// src/pages/resources.astro — free resources index
import Base from "../layouts/Base.astro";
import NewsletterCta from "../components/NewsletterCta.astro";

const resources = [
  { title: "Remote Hiring Checklist", text: "Step-by-step checklist for hiring your first remote team members. Includes interview questions, onboarding steps, and legal considerations.", href: "/startup/hiring-for-startups", cta: "Read the Guide" },
  { title: "SaaS Metrics Calculator", text: "Calculate LTV:CAC ratio, burn multiple, and growth rate. Understand your SaaS metrics in real-time.", href: "/calculator", cta: "Use Calculator" },
  { title: "EOS Implementation Guide", text: "Learn how to implement the Entrepreneurial Operating System in your startup. Includes meeting templates and accountability tools.", href: "/blog", cta: "Explore Guides" },
  { title: "Remote Onboarding Blueprint", text: "30-60-90 day onboarding plan for remote employees. Ensure new hires feel connected and productive from day one.", href: "/remote-work/strategies-for-remote-onboarding", cta: "Read Article" },
  { title: "Productivity Framework", text: "Time-blocking templates, focus strategies, and tools for remote work productivity. Based on proven systems from successful founders.", href: "/productivity", cta: "Learn More" },
  { title: "100+ Founder Articles", text: "Deep-dive guides on building startups, managing teams, marketing strategies, and operational excellence. All tactical, no fluff.", href: "/blog", cta: "Browse All Articles" },
];
---
<Base title="Free Resources for Founders | Startup Yeti" description="Free templates, checklists, and frameworks for building and scaling remote teams. Download immediately, no signup required." path="/resources">
  <section class="hero-tint border-b border-slate-200 dark:border-slate-800">
    <div class="wrap pb-14 pt-16 text-center md:pb-20 md:pt-24">
      <p class="chip">100% Free · No Signup Required</p>
      <h1 class="display mx-auto mt-5 max-w-4xl text-4xl leading-[1.08] sm:text-5xl lg:text-6xl">Free Resources for Founders</h1>
      <p class="lead mx-auto mt-6 max-w-2xl">Templates, checklists, and frameworks to help you build and scale your remote team. Download immediately, use forever.</p>
    </div>
  </section>

  <section class="wrap py-12 md:py-16">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {resources.map((r) => (
        <li class="card card-hover flex flex-col p-6 md:p-8">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white"><a href={r.href} class="hover:text-yeti-800 dark:hover:text-yeti-300">{r.title}</a></h2>
          <p class="mt-3 flex-1 text-slate-600 dark:text-slate-300">{r.text}</p>
          <a href={r.href} class="link mt-5 inline-block">{r.cta} →</a>
        </li>
      ))}
    </ul>
  </section>

  <NewsletterCta heading="Want More Resources?" body="Get weekly tactical advice on building and growing your startup. No spam, unsubscribe anytime." />
</Base>
