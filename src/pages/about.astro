---
// src/pages/about.astro — About / Team page: author identity for E-E-A-T and Google Knowledge Panel
import Base from "../layouts/Base.astro";

const siteUrl = "https://www.startupyeti.com";
const pageUrl = `${siteUrl}/about`;
const pageTitle = "About Boban Ilik | Startup Yeti";
const pageDescription = "Meet Boban Ilik, AI Growth Marketer and Outreach Manager, founder of Startup Yeti — tactical no-fluff advice helping founders build and grow their startups.";

const author = {
  name: "Boban Ilik",
  title: "AI Growth Marketer & Outreach Manager",
  photo: "/team/boban-about.webp",
  photoLarge: "https://www.startupyeti.com/team/boban-about-800.jpg",
  linkedin: "https://www.linkedin.com/in/bobanilik/",
  bio: [
    "Boban Ilik is an AI Growth Marketer and Outreach Manager with deep expertise in link-building, multilingual outreach strategy, and AI-driven growth. He founded Startup Yeti to give founders a no-fluff resource for navigating remote work, team management, and startup scaling — the things he works on every day.",
    "His professional work spans executing high-impact link-building campaigns, building strategic partnerships, and applying AI tooling to growth workflows. He follows the work of leading SEO minds including Lily Ray, Kevin Indig, and Gael Breton, and recommends The Authority Hacker podcast to anyone serious about building an online presence.",
    "Outside of work, Boban recharges with hiking, mountain biking, and snowboarding — and spends as much time as possible with his family."
  ],
  expertise: ["AI-Driven Growth Marketing", "Outreach & Link Building", "Remote Team Strategy", "Startup Scaling", "SEO & Content Strategy", "Founder Productivity"],
  influences: ["Lily Ray", "Kevin Indig", "Gael Breton"],
};
---
<Base title={pageTitle} description={pageDescription} path="/about" ogType="profile" ogImage={author.photoLarge} ogImageWidth={800} ogImageHeight={800}>
  <Fragment slot="head">
    <meta property="profile:first_name" content="Boban" />
    <meta property="profile:last_name" content="Ilik" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "@id": `${pageUrl}#profilepage`,
      "url": pageUrl,
      "inLanguage": "en-US",
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "mainEntity": {
        "@type": "Person",
        "@id": `${siteUrl}/about#person`,
        "name": author.name,
        "jobTitle": author.title,
        "url": pageUrl,
        "image": { "@type": "ImageObject", "url": author.photoLarge, "width": 800, "height": 800 },
        "description": author.bio[0],
        "sameAs": [author.linkedin],
        "knowsAbout": ["AI marketing", "growth marketing", "outreach strategy", "link building", "remote work", "team management", "startup scaling", "SEO", "founder productivity"],
        "worksFor": { "@id": `${siteUrl}/#organization` },
        "founder": { "@id": `${siteUrl}/#organization` }
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "Startup Yeti",
      "url": siteUrl,
      "logo": { "@type": "ImageObject", "url": `${siteUrl}/logo.png`, "width": 200, "height": 60 },
      "description": "Startup Yeti helps founders build and grow their startups with tactical, no-fluff advice on marketing, operations, productivity, and leadership.",
      "founder": { "@id": `${siteUrl}/about#person` },
      "knowsAbout": ["startups", "remote work", "productivity", "team management", "founder wellbeing", "marketing"],
      "sameAs": ["https://www.linkedin.com/company/startup-yeti/"]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "About", "item": pageUrl }
      ]
    })} />
  </Fragment>

  <section class="wrap-narrow pt-12 md:pt-16">
    <nav aria-label="Breadcrumb" class="meta">
      <a href="/" class="hover:text-slate-900 dark:hover:text-white">Home</a><span aria-hidden="true" class="mx-1.5">/</span><span class="text-slate-700 dark:text-slate-200">About</span>
    </nav>
    <div class="mt-8 flex flex-col gap-8 sm:flex-row sm:items-start">
      <img src={author.photo} alt={`${author.name} — ${author.title}`} width="352" height="352" loading="eager" fetchpriority="high" class="h-36 w-36 shrink-0 rounded-lg object-cover sm:h-44 sm:w-44" />
      <div>
        <h1 class="display text-4xl md:text-5xl">{author.name}</h1>
        <p class="lead mt-2">{author.title}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={author.linkedin} target="_blank" rel="noopener noreferrer" class="btn-primary">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <a href="/blog" class="btn-secondary">Read Articles →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap-narrow section grid gap-12 md:grid-cols-3">
    <div class="md:col-span-2">
      <h2 class="display text-2xl md:text-3xl">About Boban</h2>
      <div class="mt-5 space-y-5 text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        {author.bio.map((para) => <p>{para}</p>)}
      </div>
    </div>
    <div class="space-y-8">
      <div>
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Expertise</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-700 dark:text-slate-200">
          {author.expertise.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Follows &amp; Recommends</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-700 dark:text-slate-200">
          {author.influences.map((name) => <li>{name}</li>)}
          <li>The Authority Hacker podcast</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900">
    <div class="wrap-narrow section">
      <h2 class="display text-2xl md:text-3xl">About Startup Yeti</h2>
      <div class="mt-5 space-y-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        <p>Startup Yeti is a business blog for founders who are serious about building and scaling. Every article is written from hands-on experience — no recycled advice, no padding. Topics span startups, remote work, productivity, team management, marketing, and founder wellbeing.</p>
        <p>The goal is simple: give founders the tactical clarity they need to make better decisions, faster.</p>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/blog" class="btn-primary">Browse All Articles</a>
        <a href="https://www.linkedin.com/company/startup-yeti/" target="_blank" rel="noopener noreferrer" class="btn-secondary">Follow on LinkedIn</a>
      </div>
    </div>
  </section>
</Base>
