---
// src/pages/startup.astro — Startup category landing page
import CategoryPage from "../components/CategoryPage.astro";
---
<CategoryPage
  slug="startup"
  name="Startup"
  title="Startup Advice & Guides | Startup Yeti"
  description="Everything founders need to know about building and scaling startups. From fundraising to product-market fit, get tactical advice for early-stage ventures."
  h1="Startup Advice for Modern Founders"
  intro="From idea to scale. Tactical frameworks for fundraising, product-market fit, hiring, and everything in between."
  topics={[
    { title: "Fundraising", text: "Bootstrap, borrow, or bring in angels. Navigate seed rounds and VC relationships." },
    { title: "Product-Market Fit", text: "Find your ICP, validate demand, and iterate toward product-market fit." },
    { title: "Team Building", text: "Co-founders, early hires, and building high-performing startup teams." },
  ]}
  latestHeading="Latest Startup Articles"
  emptyText="Check back soon for startup content!"
  ctaHeading="Join Fellow Founders"
  ctaBody="Get weekly tactical advice on building and scaling startups delivered to your inbox."
/>
